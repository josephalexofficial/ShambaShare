# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (powers the ShambaShare AI assistant) — server-side only, never expose
OPENAI_API_KEY=
# Optional overrides
OPENAI_ASSISTANT_MODEL=gpt-4o-mini

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (server only) — required on Vercel for reliable hosted auth:
# - Join creates users with email already confirmed (login works across devices)
# - Auto-repair of older unconfirmed accounts on Sign in
# - Super admin can create sub-admins without replacing their session
# Find it in Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Africa's Talking SMS
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
SMS_MODE=mock

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (powers the ShambaShare AI assistant) — server-side only, never expose
OPENAI_API_KEY=
# Optional overrides
OPENAI_ASSISTANT_MODEL=gpt-4o-mini

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (server only) — needed so the super admin can create sub-admins
# in Supabase Auth without replacing their own login session.
SUPABASE_SERVICE_ROLE_KEY=

# Africa's Talking SMS
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
SMS_MODE=mock
